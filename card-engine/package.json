{
  "name": "card-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "build:game": "tsc -b && tsc -p tsconfig.api.json && vite build --mode game --outDir ../game/dist --emptyOutDir",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:engines": "GEN_DOCS=1 vitest run src/services/engineReference/generateEngineReference.test.ts",
    "assets:pack": "node scripts/phaser-editor/build-asset-pack.mjs",
    "assets:pack:check": "node scripts/phaser-editor/build-asset-pack.mjs --check",
    "assets:lint": "node scripts/phaser-editor/lint-assets.mjs",
    "effects:pack": "python scripts/effects/pack_effects.py",
    "effects:pack:check": "python scripts/effects/pack_effects.py --check",
    "castle:composition": "node scripts/castle/composition.mjs",
    "snapshot:ai": "node ../scripts/create-ai-snapshot.mjs",
    "production:page": "node scripts/production-page/build.mjs",
    "castle:sheet": "python scripts/bg-harness/build-castle-sheet.py",
    "castle:index": "python scripts/bg-harness/lib/export_indexed.py public/assets/kits/halo-stone-castle/structures/walls/castle-wall-straight-v3.png public/assets/kits/halo-stone-castle/structures/walls/castle-wall-side-v3.png public/assets/kits/halo-stone-castle/structures/gate/castle-gate-house-v3.png public/assets/kits/halo-stone-castle/structures/towers/castle-tower-corner-v3.png public/assets/kits/halo-stone-castle/structures/towers/castle-tower-battle-v3.png public/assets/kits/halo-stone-castle/structures/buildings/castle-forge-v2.png public/assets/kits/halo-stone-castle/structures/buildings/castle-archivist-v2.png public/assets/kits/halo-stone-castle/terrain/cliff-kit-v1 --palette-out public/assets/kits/halo-stone-castle --verify",
    "palette:check": "python scripts/bg-harness/lib/check_palette.py public/assets/kits/halo-stone-castle/structures/walls/castle-wall-straight-v3.png public/assets/kits/halo-stone-castle/structures/walls/castle-wall-side-v3.png public/assets/kits/halo-stone-castle/structures/gate/castle-gate-house-v3.png public/assets/kits/halo-stone-castle/structures/towers/castle-tower-corner-v3.png public/assets/kits/halo-stone-castle/structures/towers/castle-tower-battle-v3.png public/assets/kits/halo-stone-castle/structures/buildings/castle-forge-v2.png public/assets/kits/halo-stone-castle/structures/buildings/castle-archivist-v2.png public/assets/kits/halo-stone-castle/terrain/cliff-kit-v1 --palette public/assets/kits/halo-stone-castle/castle-kit.hex",
    "castle:gen": "node scripts/bg-harness/harness.mjs gen castle-grand-topdown $npm_config_state && npm run castle:sheet"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.110.7",
    "idb": "^8.0.3",
    "lucide-react": "^1.25.0",
    "phaser": "^3.90.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.26",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
