# Local dependency/build trees are recreated by Vercel and must never upload.
**/node_modules/
**/dist/
**/.vite/
**/*.tsbuildinfo

# Session-local AI studio state and historical worktrees are not Wiki inputs.
.claude/
.agents/
.codex/

# The Wiki consumes card-engine/src and card-engine/public only.
card-engine/api/
card-engine/scripts/
card-engine/supabase/
card-engine/scratch-assets/
card-engine/.claude/

# Public assets are an explicit web-sized subset. The Wiki reuses these
# canonical files directly; unused game plates and runtime layers stay home.
card-engine/public/assets/backgrounds/
card-engine/public/assets/badges/
card-engine/public/assets/economy/
card-engine/public/assets/icons/
card-engine/public/assets/castle/layers/
card-engine/public/assets/castle/occluders/
card-engine/public/assets/castle/hero/
card-engine/public/assets/castle/pixel-sample/
card-engine/public/assets/castle/keepers/
card-engine/public/assets/combat/bosses/emberborn-wraith/
card-engine/public/assets/combat/arenas/forbidden-mountain-passage/
card-engine/public/assets/combat/shelf/
card-engine/public/assets/combat/projectiles/

# Non-web production sources are documented by path but not deployed.
Card Images/
Classes and Boss Battles/
Combat_Fullscreen_Correction_Handoff/
docs/archive/

# Local-only deployment and scratch state.
.vercel/
.env*
ai-snapshot-output/
scratchpad/
CARD_ENGINE_STUDIO_V2_PROMPTS.md
